# This is a template to build a list of alpine (Alpine Linux / apk) repositories to import
# Alpine Linux source repositories can only be used by mirrors
# Check out others YAML files in the same directory to see real examples
---
# Quick description that describe this list of repositories
# This description is what will be displayed in the UI when selecting the list of repositories to import
# e.g. Alpine Linux official repositories
description:
type: alpine
repositories:
    # Name of the source repository
    # Must be unique to avoid conflicts and overwriting other repositories
    # e.g. alpine
  - name:
    # Type of package repository
    type: alpine
    # Quick description of the source repository
    # e.g. Alpine Linux official repositories
    description:
    # URL of the repository, as declared in /etc/apk/repositories
    # $branch is replaced by the branch of the mirror, $repo by each repository
    # The architecture is appended to the URL, as apk does: the URL must contain the <arch>/APKINDEX.tar.gz index
    # e.g. https://dl-cdn.alpinelinux.org/alpine/$branch/$repo
    url:
    # List of branches available, a mirror contains one branch
    # /!\ Remove this section if the URL does not contain $branch (repository with a single branch)
    branches:
        # The name of the branch
        # e.g. v3.24
      - name:
        # Description of the branch
        # e.g. Alpine Linux 3.24
        description:
        # End of life date of the branch (optional, YYYY-MM-DD), the branch is marked as EOL after this date
        # e.g. 2028-06-01
        eol:
    # List of repositories available
    # /!\ Remove this section if the URL does not contain $repo (single repository, e.g. https://apk.corretto.aws)
    repos:
        # The name of the repository
        # e.g. main
      - name:
        # Description of the repository
        # e.g. Alpine Linux main
        description:
    # List of architectures available
    archs:
        # e.g. x86_64
      - name:
    # The RSA public keys used to sign the repository indexes, as installed in /etc/apk/keys/ on clients
    # Each key is downloaded from its link, and named after the link file name unless a name is specified
    # The name must be the name of the key file on clients, as the index signature references it
    keys:
        # The URL to the public key
        # e.g. https://alpinelinux.org/keys/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub
      - link:
        # Optional: the name of the key file, if it differs from the link file name
        # e.g. alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub
        name:
    # If the repository is protected by SSL authentication, you can provide the certificate, private key and CA certificate
    # /!\ Remove this section if the repository is not protected by SSL authentication
    ssl-authentication:
      # The certificate used to authenticate the repository, plain text format
      certificate: |
        -----BEGIN CERTIFICATE-----
      # The private key used to authenticate the repository, plain text format
      private-key: |
        -----BEGIN PRIVATE KEY-----
      # The CA certificate used to authenticate the repository, plain text format
      ca-certificate: |
        -----BEGIN CERTIFICATE-----
    # If the repository is protected by HTTP basic authentication, you can provide the username and password
    # /!\ Remove this section if the repository is not protected by basic authentication
    basic-authentication:
      username:
      password:
